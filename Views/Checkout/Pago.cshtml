@{
    Layout = null; // Pantalla de pago segura, sin distracciones
    ViewData["Title"] = "Finalizar Pedido - Biblio UTEC";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    
    <style>
        body { background-color: #fff; font-family: "Segoe UI", Arial, sans-serif; }
        .checkout-header { background-color: #fafafa; border-bottom: 1px solid #e7e7e7; padding: 15px 0; margin-bottom: 30px; }
        .utec-logo { font-size: 1.8rem; font-weight: 800; color: #111; text-decoration: none; letter-spacing: -1px; }
        .utec-logo:hover { color: #111; text-decoration: none; }
        
        .step-number { font-weight: bold; font-size: 1.1rem; color: #c45500; margin-right: 10px; }
        .step-title { font-weight: 700; font-size: 1.2rem; color: #111; border-bottom: 1px solid #e7e7e7; padding-bottom: 10px; margin-bottom: 15px; }
        
        .summary-box { border: 1px solid #d5d9d9; border-radius: 8px; padding: 20px; background-color: #f3f3f3; }
        .btn-amazon-yellow { background-color: #ffd814; border-color: #fcd200; border-radius: 8px; font-weight: 500; width: 100%; padding: 10px; box-shadow: 0 1px 2px rgba(0,0,0,0.1); }
        .btn-amazon-yellow:hover { background-color: #f7ca00; }
        
        .card-element-container { border: 1px solid #ccc; padding: 12px; border-radius: 4px; background-color: #fff; margin-bottom: 10px; }
        .text-amazon-blue { color: #007185; cursor: pointer; text-decoration: none; }
        .text-amazon-blue:hover { color: #c45500; text-decoration: underline; }
    </style>
</head>
<body>

    <header class="checkout-header text-center">
        <div class="container d-flex justify-content-between align-items-center">
            <a href="/Home/Index" class="utec-logo">BIBLIO-UTEC</a>
            <h3 class="mb-0 font-weight-light text-muted">Finalizar pedido</h3>
            <i class="fas fa-lock text-muted fa-2x"></i>
        </div>
    </header>

    <div class="container mb-5">
        <div class="row">
            
            <div class="col-md-8 pr-md-5">
                
                <div class="mb-4">
                    <h4 class="step-title"><span class="step-number">1</span> Dirección de entrega</h4>
                    <div class="pl-4 ml-2">
                        <div class="d-flex justify-content-between">
                            <div>
                                <p class="font-weight-bold mb-0">Casillero Universitario (Estudiante UTEC)</p>
                                <p class="text-muted small mb-0">Calle Arce, San Salvador</p>
                                <p class="text-muted small mb-0">El Salvador</p>
                            </div>
                            <a href="#" class="text-amazon-blue small">Cambiar</a>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <h4 class="step-title"><span class="step-number">2</span> Método de pago</h4>
                    <div class="pl-4 ml-2">
                        <div class="d-flex justify-content-between mb-3">
                            <div class="d-flex align-items-center">
                                <i class="fab fa-cc-visa fa-2x text-primary mr-3"></i>
                                <div>
                                    <p class="font-weight-bold mb-0">Visa terminada en 4242</p>
                                    <p class="text-muted small mb-0">Billetera Digital - Expira en 12/2028</p>
                                </div>
                            </div>
                            <a href="#" class="text-amazon-blue small">Cambiar</a>
                        </div>

                        <div class="card-element-container d-none" id="nuevoMetodoPago">
                            <p class="small font-weight-bold mb-2">Ingresa una nueva tarjeta de crédito o débito:</p>
                            <div class="input-group mb-2">
                                <div class="input-group-prepend"><span class="input-group-text bg-white border-right-0"><i class="far fa-credit-card"></i></span></div>
                                <input type="text" class="form-control border-left-0" placeholder="Número de tarjeta" readonly>
                            </div>
                            <div class="row">
                                <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="MM / AA" readonly></div>
                                <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="CVC" readonly></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <h4 class="step-title"><span class="step-number">3</span> Revisar artículos y envío</h4>
                    <div class="pl-4 ml-2 border rounded p-3 mb-3">
                        <h6 class="font-weight-bold text-success mb-3">Entrega garantizada: Mañana antes de las 12:00 PM</h6>
                        
                        <div class="d-flex mb-3">
                            <img src="https://covers.openlibrary.org/b/isbn/9780486490335-M.jpg" alt="Libro" class="mr-3 shadow-sm" style="width: 60px; height: 90px; object-fit: cover;">
                            <div>
                                <h6 class="font-weight-bold mb-1">Space Mathematics: Everyday and Extraordinary</h6>
                                <p class="text-danger font-weight-bold mb-1">US$ 24.99</p>
                                <p class="small text-muted mb-0">Cantidad: 1 | <span class="badge badge-secondary">Físico</span></p>
                            </div>
                        </div>

                        <div class="d-flex border-top pt-3">
                            <img src="https://covers.openlibrary.org/b/isbn/9780132350884-M.jpg" alt="Libro" class="mr-3 shadow-sm" style="width: 60px; height: 90px; object-fit: cover;">
                            <div>
                                <h6 class="font-weight-bold mb-1">Clean Code: A Handbook of Agile Software</h6>
                                <p class="text-success font-weight-bold mb-1">Gratis</p>
                                <p class="small text-muted mb-0">Cantidad: 1 | <span class="badge badge-success">Préstamo</span></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="summary-box">
                    <button class="btn btn-amazon-yellow mb-3" onclick="procesarPagoSeguro()">Realizar tu pedido</button>
                    <p class="text-center small text-muted border-bottom pb-3">Al realizar tu pedido, aceptas el <a href="#" class="text-amazon-blue">Aviso de privacidad</a> y las <a href="#" class="text-amazon-blue">Condiciones de uso</a> de Biblio-UTEC.</p>
                    
                    <h5 class="font-weight-bold mb-3">Resumen del pedido</h5>
                    
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Productos (2):</span>
                        <span>US$ 24.99</span>
                    </div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Envío (Casillero UTEC):</span>
                        <span>US$ 0.00</span>
                    </div>
                    <div class="d-flex justify-content-between small mb-1 border-bottom pb-2">
                        <span>Préstamos Digitales:</span>
                        <span>US$ 0.00</span>
                    </div>
                    
                    <div class="d-flex justify-content-between mt-2 mb-4">
                        <h5 class="font-weight-bold text-danger mb-0">Total:</h5>
                        <h5 class="font-weight-bold text-danger mb-0">US$ 24.99</h5>
                    </div>

                    <div class="mb-3 d-flex justify-content-center">
                        <div class="g-recaptcha" data-sitekey="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="modal fade" id="modalProcesando" tabindex="-1" data-backdrop="static" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg text-center p-4">
                <div class="spinner-border text-warning mx-auto mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
                <h6 class="font-weight-bold">Procesando pago seguro...</h6>
                <p class="small text-muted mb-0">Conectando con Stripe</p>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        function procesarPagoSeguro() {
            var response = grecaptcha.getResponse();
            
            if(response.length === 0) { 
                alert("Por motivos de seguridad transaccional, por favor verifica el ReCaptcha antes de realizar el cobro a tu tarjeta.");
                return;
            }

            // Mostrar animación de carga
            $('#modalProcesando').modal('show');

            // Simular tiempo de respuesta de la API de Stripe
            setTimeout(function() {
                $('#modalProcesando').modal('hide');
                alert("¡Pago procesado exitosamente! Tu pedido ha sido confirmado.");
                // Redirigir a las transacciones
                window.location.href = '/Prestamos/MisPrestamos';
            }, 2500);
        }
    </script>
</body>
</html>