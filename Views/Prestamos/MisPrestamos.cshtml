@{
    ViewData["Title"] = "Mis Transacciones";
}

<style>
    /* Tipografía y colores estilo Amazon */
    .text-amazon-blue { color: #007185; text-decoration: none; }
    .text-amazon-blue:hover { color: #c45500; text-decoration: underline; }
    .btn-amazon-yellow { background-color: #ffd814; border-color: #fcd200; color: #0f1111; border-radius: 8px; font-size: 0.9rem; }
    .btn-amazon-yellow:hover { background-color: #f7ca00; border-color: #f2c200; }
    .btn-amazon-light { background-color: #fff; border: 1px solid #d5d9d9; color: #0f1111; border-radius: 8px; font-size: 0.9rem; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
    .btn-amazon-light:hover { background-color: #f7fafa; }
    
    /* Pestañas (Tabs) */
    .nav-tabs .nav-link { color: #007185; font-weight: 500; border: none; border-bottom: 2px solid transparent; padding: 10px 20px; }
    .nav-tabs .nav-link:hover { color: #c45500; border-bottom: 2px solid #c45500; }
    .nav-tabs .nav-link.active { color: #111; font-weight: 700; border-bottom: 2px solid #e77600; background-color: transparent; }
    
    /* Tarjetas de Pedidos */
    .order-card { border: 1px solid #d5d9d9; border-radius: 8px; margin-bottom: 20px; overflow: hidden; }
    .order-header { background-color: #f0f2f2; padding: 14px 20px; border-bottom: 1px solid #d5d9d9; font-size: 0.85rem; color: #555; }
    .order-body { padding: 20px; background-color: #fff; }
    
    .status-text { font-size: 1.1rem; font-weight: 700; margin-bottom: 5px; }
    .status-warning { color: #c45500; }
    .status-success { color: #067d62; }
    .status-danger { color: #B12704; }
</style>

<div class="container my-5">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="font-weight-bold mb-0">Hola, @(Context.Session.GetString("UsuarioNombre") ?? "Angel")</h2>
        <div class="input-group" style="max-width: 300px;">
            <input type="text" class="form-control form-control-sm" placeholder="Buscar en mis pedidos...">
            <div class="input-group-append">
                <button class="btn btn-dark btn-sm" type="button">Buscar</button>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs mb-4" id="transaccionesTab" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link active" id="prestamos-tab" data-toggle="tab" href="#prestamos" role="tab">Préstamos Activos</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" id="compras-tab" data-toggle="tab" href="#compras" role="tab">Mis Compras</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" id="historial-tab" data-toggle="tab" href="#historial" role="tab">Devoluciones e Historial</a>
        </li>
    </ul>

    <div class="tab-content" id="transaccionesTabContent">
        
        <div class="tab-pane fade show active" id="prestamos" role="tabpanel">
            
            <div class="order-card shadow-sm">
                <div class="order-header d-flex justify-content-between">
                    <div class="d-flex" style="gap: 30px;">
                        <div>
                            <span class="d-block text-uppercase">Fecha de solicitud</span>
                            <span class="text-dark">15 de Mayo de 2026</span>
                        </div>
                        <div>
                            <span class="d-block text-uppercase">Total</span>
                            <span class="text-dark">Gratis (Catálogo Digital)</span>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="d-block text-uppercase">Nº de Préstamo</span>
                        <a href="#" class="text-amazon-blue">#114-9876543-00001</a>
                    </div>
                </div>
                <div class="order-body row">
                    <div class="col-md-8 d-flex">
                        <img src="https://covers.openlibrary.org/b/isbn/9780486490335-M.jpg" 
                            onerror="this.src='https://via.placeholder.com/90x135.png?text=Sin+Portada'" 
                            alt="Space Mathematics" class="mr-4 shadow-sm" style="width: 90px; height: 135px; object-fit: cover;">
                        <div>
                            <div class="status-text status-warning">Vence en 3 días</div>
                            <p class="small text-muted mb-2">Debes devolver o renovar este libro antes del <strong>22 de Mayo de 2026</strong>.</p>
                            <a href="/Catalog/Detalles" class="font-weight-bold text-amazon-blue" style="font-size: 1.1rem;">Space Mathematics: Everyday and Extraordinary</a>
                            <p class="text-muted small mt-1 mb-0">F. J. Weyl</p>
                            <span class="badge badge-success mt-2">Préstamo Digital</span>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex flex-column justify-content-center">
                        <a href="https://play.google.com/books/reader?id=MAC_AgAAQBAJ&pg=GBS.PP1" target="_blank" class="btn btn-amazon-yellow w-100 mb-2 font-weight-bold shadow-sm text-center" style="padding: 8px 0; text-decoration: none;">
                        Leer en Google Books <i class="fas fa-external-link-alt ml-1" style="font-size: 0.8em;"></i>
                        </a>
                        <button class="btn btn-amazon-light w-100 shadow-sm">Solicitar renovación</button>
                    </div>
                </div>
            </div>

            <div class="order-card shadow-sm">
                <div class="order-header d-flex justify-content-between">
                    <div class="d-flex" style="gap: 30px;">
                        <div>
                            <span class="d-block text-uppercase">Fecha de solicitud</span>
                            <span class="text-dark">18 de Mayo de 2026</span>
                        </div>
                        <div>
                            <span class="d-block text-uppercase">Total</span>
                            <span class="text-dark">Gratis (Catálogo Digital)</span>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="d-block text-uppercase">Nº de Préstamo</span>
                        <a href="#" class="text-amazon-blue">#114-9876543-00002</a>
                    </div>
                </div>
                <div class="order-body row">
                    <div class="col-md-8 d-flex">
                        <img src="https://covers.openlibrary.org/b/isbn/9780132350884-M.jpg" alt="Clean Code" class="mr-4 shadow-sm" style="width: 90px; height: 135px; object-fit: cover;">
                        <div>
                            <div class="status-text status-success">Activo</div>
                            <p class="small text-muted mb-2">Vence el <strong>18 de Junio de 2026</strong>.</p>
                            <a href="/Catalog/Detalles" class="font-weight-bold text-amazon-blue" style="font-size: 1.1rem;">Clean Code: A Handbook of Agile Software Craftsmanship</a>
                            <p class="text-muted small mt-1 mb-0">Robert C. Martin</p>
                            <span class="badge badge-success mt-2">Préstamo Digital</span>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex flex-column justify-content-center">
                        <button class="btn btn-amazon-yellow w-100 mb-2 font-weight-bold shadow-sm">Leer ahora</button>
                        <button class="btn btn-amazon-light w-100 shadow-sm">Devolver anticipadamente</button>
                    </div>
                </div>
            </div>

        </div>

        <div class="tab-pane fade" id="compras" role="tabpanel">
            
            <div class="order-card shadow-sm">
                <div class="order-header d-flex justify-content-between">
                    <div class="d-flex" style="gap: 30px;">
                        <div>
                            <span class="d-block text-uppercase">Pedido realizado</span>
                            <span class="text-dark">10 de Mayo de 2026</span>
                        </div>
                        <div>
                            <span class="d-block text-uppercase">Total</span>
                            <span class="text-dark">US$ 69.98</span>
                        </div>
                        <div>
                            <span class="d-block text-uppercase">Enviado a</span>
                            <a href="#" class="text-amazon-blue">@(Context.Session.GetString("UsuarioNombre") ?? "Estudiante") <i class="fas fa-angle-down"></i></a>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="d-block text-uppercase">Nº de pedido</span>
                        <a href="#" class="text-amazon-blue">#113-1234567-89012</a>
                    </div>
                </div>
                <div class="order-body row">
                    <div class="col-md-8 d-flex">
                        <img src="https://covers.openlibrary.org/b/isbn/9781118392517-M.jpg" alt="Spacecraft Systems" class="mr-4 shadow-sm" style="width: 90px; height: 135px; object-fit: cover;">
                        <div>
                            <div class="status-text status-success">Entregado el 12 de Mayo</div>
                            <p class="small text-muted mb-2">Tu paquete fue entregado en el casillero de la universidad.</p>
                            <a href="/Catalog/Detalles" class="font-weight-bold text-amazon-blue" style="font-size: 1.1rem;">Spacecraft Systems Engineering</a>
                            <p class="text-muted small mt-1 mb-0">Vendido por: Librería Universitaria</p>
                            <span class="badge badge-secondary mt-2">Libro Físico</span>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex flex-column justify-content-center">
                        <button class="btn btn-amazon-yellow w-100 mb-2 font-weight-bold shadow-sm">Rastrear paquete</button>
                        <button class="btn btn-amazon-light w-100 mb-2 shadow-sm">Escribir una opinión</button>
                        <button class="btn btn-amazon-light w-100 shadow-sm">Comprar de nuevo</button>
                    </div>
                </div>
            </div>

        </div>

        <div class="tab-pane fade" id="historial" role="tabpanel">
            
            <div class="order-card shadow-sm opacity-75" style="opacity: 0.8;">
                <div class="order-header d-flex justify-content-between">
                    <div class="d-flex" style="gap: 30px;">
                        <div>
                            <span class="d-block text-uppercase">Fecha de solicitud</span>
                            <span class="text-dark">1 de Abril de 2026</span>
                        </div>
                        <div>
                            <span class="d-block text-uppercase">Estado</span>
                            <span class="text-dark">Devuelto</span>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="d-block text-uppercase">Nº de Préstamo</span>
                        <span class="text-muted">#114-0000000-00003</span>
                    </div>
                </div>
                <div class="order-body row">
                    <div class="col-md-8 d-flex">
                        <img src="https://covers.openlibrary.org/b/isbn/9780439136358-M.jpg" alt="Harry Potter" class="mr-4 shadow-sm" style="width: 90px; height: 135px; object-fit: cover; filter: grayscale(50%);">
                        <div>
                            <div class="status-text text-muted">Préstamo finalizado</div>
                            <p class="small text-muted mb-2">Devuelto exitosamente el <strong>30 de Abril de 2026</strong>.</p>
                            <a href="/Catalog/Detalles" class="font-weight-bold text-amazon-blue" style="font-size: 1.1rem;">Harry Potter y el Prisionero de Azkaban</a>
                            <p class="text-muted small mt-1 mb-0">J.K. Rowling</p>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex flex-column justify-content-center">
                        <button class="btn btn-amazon-light w-100 mb-2 shadow-sm">Prestar nuevamente</button>
                        <button class="btn btn-amazon-light w-100 shadow-sm">Eliminar del historial</button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>