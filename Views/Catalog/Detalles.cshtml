                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-4 col-6 mb-3">
                        <div class="card h-100 border-0 shadow-sm book-card-amazon">
                            <a href="/Catalog/Detalles"><img src="https://covers.openlibrary.org/b/isbn/9780201835953-L.jpg" class="card-img-top p-3 book-cover-img" alt="Mythical Man-Month"></a>
                            <div class="card-body p-2">
                                <a href="/Catalog/Detalles" class="text-decoration-none"><h6 class="card-title text-truncate mb-0 text-amazon-blue">Mythical Man-Month</h6></a>
