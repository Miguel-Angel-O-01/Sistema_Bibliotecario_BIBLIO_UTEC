                    <div class="col-12 text-center p-5 text-muted">Más libros relacionados cargando...</div>
                </div>
            </div>
        </div>
        <a class="carousel-control-prev" href="#carouselRelacionados" role="button" data-slide="prev"><span class="carousel-arrow-icon"><i class="fas fa-chevron-left"></i></span></a>
        <a class="carousel-control-next" href="#carouselRelacionados" role="button" data-slide="next"><span class="carousel-arrow-icon"><i class="fas fa-chevron-right"></i></span></a>
    </div>

    <h4 class="shelf-title-amazon mb-4">Inspirado en tu historial de búsqueda</h4>
