</div>

<div class="modal fade" id="modalDevoluciones" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-undo-alt text-info mr-2"></i> Políticas de Préstamo Digital</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body text-dark" style="font-size: 0.95rem;">
                <p>Al adquirir un préstamo digital mediante el Catálogo de Biblio-UTEC, aceptas las siguientes condiciones:</p>
                <ul class="text-muted">
                    <li class="mb-2">El libro estará disponible en tu dispositivo durante un periodo máximo de <strong>30 días naturales</strong>.</li>
                    <li class="mb-2">Una vez vencido el plazo, el sistema revocará el acceso automáticamente, simulando una devolución (reintegro).</li>
                    <li>Si necesitas más tiempo, podrás solicitar una renovación desde tu panel de "Mis Préstamos Activos", siempre y cuando no haya lista de espera.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalSeguridad" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-shield-alt text-success mr-2"></i> Transacción Segura UTEC</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body text-dark" style="font-size: 0.95rem;">
                <p>Tu seguridad es nuestra prioridad. Trabajamos duro para proteger tu seguridad y privacidad.</p>
                <ul class="text-muted">
                    <li class="mb-2">Nuestro sistema de seguridad encripta tu información durante la transmisión.</li>
                    <li>Todas las transacciones son procesadas bajo los estándares de la Universidad Tecnológica.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalOpinion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-weight-bold">Escribir una opinión</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group mb-4">
                    <label class="font-weight-bold">Calificación general</label>
                    <div class="star-rating-interactive" style="font-size: 1.8rem;" id="selectorEstrellas">
                        <i class="fas fa-star" onclick="marcarEstrellas(1)"></i>
                        <i class="fas fa-star" onclick="marcarEstrellas(2)"></i>
                        <i class="fas fa-star" onclick="marcarEstrellas(3)"></i>
                        <i class="fas fa-star" onclick="marcarEstrellas(4)"></i>
                        <i class="fas fa-star" onclick="marcarEstrellas(5)"></i>
                    </div>
                    <input type="hidden" id="inputPuntuacion" value="5">
                </div>
                <div class="form-group">
                    <label class="font-weight-bold">Añadir un título</label>
                    <input type="text" class="form-control" id="inputTituloResena" placeholder="¿Qué es lo más importante que debes saber?">
                </div>
                <div class="form-group">
                    <label class="font-weight-bold">Añadir una reseña escrita</label>
                    <textarea class="form-control" rows="4" id="inputTextResena" placeholder="¿Qué te ha gustado o no te ha gustado?"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-amazon-yellow rounded-pill px-4" onclick="publicarOpinion()">Enviar opinión</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. FORMATOS (Intercambia qué textos y botones se ven)
        function seleccionarFormato(formato) {
            const btnDigital = document.getElementById('btnFormatDigital');
            const btnFisico = document.getElementById('btnFormatFisico');
            
            const infoDevolucionDigital = document.getElementById('infoDevolucionDigital');
            const infoEnvioFisico = document.getElementById('infoEnvioFisico');
            
            if (formato === 'digital') {
                btnDigital.classList.add('active');
                btnFisico.classList.remove('active');
                
                document.getElementById('btnPrestar').style.display = 'block';
                document.getElementById('btnAgregarCarrito').style.display = 'none';
                document.getElementById('btnComprarAhora').style.display = 'none';
                document.getElementById('selectorCantidad').style.setProperty('display', 'none', 'important');
                
                infoDevolucionDigital.style.display = 'block'; // Muestra devoluciones en digital
                infoEnvioFisico.style.display = 'none'; // Oculta remitente
                
                document.getElementById('precioCaja').innerText = 'Gratis con Préstamo UTEC';
                document.getElementById('descripcionCaja').innerText = 'Disponible instantáneamente en tu cuenta mediante el Catálogo Digital.';
                document.getElementById('estadoCaja').innerHTML = '<i class="fas fa-check-circle"></i> Disponible para préstamo';
                document.getElementById('estadoCaja').className = 'text-success small font-weight-bold mb-3';
                
            } else if (formato === 'fisico') {
                btnFisico.classList.add('active');
                btnDigital.classList.remove('active');
                
                document.getElementById('btnPrestar').style.display = 'none';
                document.getElementById('btnAgregarCarrito').style.display = 'block';
                document.getElementById('btnComprarAhora').style.display = 'block';
                document.getElementById('selectorCantidad').style.setProperty('display', 'flex', 'important');
                
                infoDevolucionDigital.style.display = 'none'; // Oculta devoluciones de digital
                infoEnvioFisico.style.display = 'block'; // Muestra remitente físico
                
                document.getElementById('precioCaja').innerText = 'US$ 24.99';
                document.getElementById('descripcionCaja').innerText = 'Libro físico nuevo. Envío disponible a través de la Universidad.';
                document.getElementById('estadoCaja').innerHTML = '<i class="fas fa-box"></i> En Stock. Cantidad limitada.';
                document.getElementById('estadoCaja').className = 'text-danger small font-weight-bold mb-3';
            }
        }

        // 2. COMPRADOS JUNTOS (Actualiza el precio texto)
        function actualizarTotalJuntos() {
            let total = 0;
            if(document.getElementById('chk1').checked) total += 24.99;
            if(document.getElementById('chk2').checked) total += 18.69;
            if(document.getElementById('chk3').checked) total += 69.98;
            document.getElementById('totalJuntos').innerText = 'US$ ' + total.toFixed(2);
        }

      // 3. LÓGICA DEL CARRITO (Nivel QA)
        function simularAgregarCarrito(tipo, precioUnitario) {
            const badgeCarrito = document.querySelector('.fa-shopping-basket').nextElementSibling;
            const spanSubtotalNav = document.getElementById('subtotalCarritoNav');
            const listaItems = document.getElementById('listaItemsCarrito');
            const mensajeVacio = document.getElementById('mensajeCarritoVacio');

            let cantidadSeleccionada = 0;
            let tituloAgregado = document.getElementById('mainBookTitle').innerText;
            let portadaAgregada = document.getElementById('mainBookCover').src;
            let costoTotalOperacion = 0;

            if(tipo === 'compra') {
                cantidadSeleccionada = parseInt(document.getElementById('inputCantidad').value);
                costoTotalOperacion = precioUnitario * cantidadSeleccionada;
            } else if (tipo === 'prestamo') {
                cantidadSeleccionada = 1;
                costoTotalOperacion = 0;
            } else if (tipo === 'multiple') {
                if(document.getElementById('chk1').checked) cantidadSeleccionada++;
                if(document.getElementById('chk2').checked) cantidadSeleccionada++;
                if(document.getElementById('chk3').checked) cantidadSeleccionada++;
                if(cantidadSeleccionada === 0) { alert("Selecciona al menos un libro."); return; }
                costoTotalOperacion = precioUnitario;
                tituloAgregado = `Paquete de ${cantidadSeleccionada} libros`;
            }

            // Ocultar mensaje de carrito vacío si existe
            if(mensajeVacio) mensajeVacio.style.display = 'none';

            // Actualizar burbuja superior
            if(badgeCarrito) {
                let cantidadActual = parseInt(badgeCarrito.innerText) || 0;
                badgeCarrito.innerText = cantidadActual + cantidadSeleccionada;
                badgeCarrito.style.transform = 'scale(1.5)';
                setTimeout(() => badgeCarrito.style.transform = 'scale(1)', 300);
            }

            // Actualizar Subtotal Dinámico
            if(spanSubtotalNav) {
                let dineroActual = parseFloat(spanSubtotalNav.innerText) || 0.00;
                let nuevoSubtotal = dineroActual + costoTotalOperacion;
                spanSubtotalNav.innerText = nuevoSubtotal.toFixed(2);
                spanSubtotalNav.style.color = "#ffa41c";
                setTimeout(() => spanSubtotalNav.style.color = "", 500);
            }

            // Generar controles +/- solo para compras físicas
            let controlesCantidad = '';
            if(tipo === 'compra') {
                controlesCantidad = `
                <div class="d-flex align-items-center mt-1">
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" style="border-radius: 4px 0 0 4px;" onclick="cambiarCantidadCarrito(this, -1, ${precioUnitario})">-</button>
                    <input type="text" value="${cantidadSeleccionada}" class="form-control form-control-sm text-center py-0 px-1 item-cantidad" style="width: 35px; border-radius: 0; height: 26px;" readonly>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" style="border-radius: 0 4px 4px 0;" onclick="cambiarCantidadCarrito(this, 1, ${precioUnitario})">+</button>
                </div>`;
            }

            let etiquetaTipo = (tipo === 'prestamo') ? '<span class="badge badge-success small">Préstamo</span>' : '<span class="badge badge-secondary small">Físico</span>';
            let precioTexto = (tipo === 'prestamo') ? 'Gratis' : `US$ ${costoTotalOperacion.toFixed(2)}`;

            // Atributos de datos (data-precio) para que la función Eliminar sepa cuánto restar
            const nuevoItemHTML = `
            <div class="d-flex mb-3 border-top pt-3 item-carrito-fila" data-precio-unitario="${tipo === 'prestamo' ? 0 : precioUnitario}">
                <img src="${portadaAgregada}" alt="Portada" class="mr-3 shadow-sm" style="width: 40px; height: 60px; object-fit: cover;">
                <div class="flex-grow-1">
                    <h6 class="mb-1 text-truncate" style="max-width: 170px; font-size: 0.85rem;">${tituloAgregado}</h6>
                    ${etiquetaTipo}
                    ${controlesCantidad}
                </div>
                <div class="text-right d-flex flex-column justify-content-between">
                    <strong style="font-size: 0.9rem;" class="precio-item-texto">${precioTexto}</strong>
                    <a href="javascript:void(0)" class="text-danger small mt-2" onclick="eliminarItemCarrito(this)">Eliminar</a>
                </div>
            </div>`;
            
            if(listaItems) listaItems.insertAdjacentHTML('beforeend', nuevoItemHTML);

            if(tipo === 'prestamo') alert("¡Préstamo digital procesado!");
            else if (tipo === 'multiple') alert("¡Se agregó el paquete al carrito!");
            else alert("¡Se agregaron libros físicos al carrito!");
        }

        // FUNCIÓN: Sumar o restar cantidades
        function cambiarCantidadCarrito(btn, delta, precioUnitario) {
            const fila = btn.closest('.item-carrito-fila');
            const inputElement = fila.querySelector('.item-cantidad');
            const precioTexto = fila.querySelector('.precio-item-texto');
            let cantidadActual = parseInt(inputElement.value);
            
            // Evitamos que baje a cero o números negativos
            if (cantidadActual + delta < 1) return;
            
            inputElement.value = cantidadActual + delta;

            // Actualizamos el precio individual de ese libro
            const nuevoPrecioFila = (cantidadActual + delta) * precioUnitario;
            precioTexto.innerText = `US$ ${nuevoPrecioFila.toFixed(2)}`;

            // Actualizamos burbuja general
            const badgeCarrito = document.querySelector('.fa-shopping-basket').nextElementSibling;
            if(badgeCarrito) badgeCarrito.innerText = parseInt(badgeCarrito.innerText) + delta;

            // Actualizamos Subtotal General
            const spanSubtotalNav = document.getElementById('subtotalCarritoNav');
            if(spanSubtotalNav) {
                let dineroActual = parseFloat(spanSubtotalNav.innerText) || 0.00;
                let nuevoSubtotal = dineroActual + (precioUnitario * delta);
                spanSubtotalNav.innerText = nuevoSubtotal.toFixed(2);
                spanSubtotalNav.style.color = "#ffa41c";
                setTimeout(() => spanSubtotalNav.style.color = "", 500);
            }
        }

        // NUEVA FUNCIÓN: Eliminar item completamente y restar del total
        function eliminarItemCarrito(btnEliminar) {
            const fila = btnEliminar.closest('.item-carrito-fila');
            const precioUnitario = parseFloat(fila.getAttribute('data-precio-unitario')) || 0;
            
            // Leemos la cantidad que tenía el libro para restar todo junto
            const inputElement = fila.querySelector('.item-cantidad');
            let cantidadRestar = inputElement ? parseInt(inputElement.value) : 1;
            let dineroRestar = precioUnitario * cantidadRestar;

            // Restar de la burbuja
            const badgeCarrito = document.querySelector('.fa-shopping-basket').nextElementSibling;
            if(badgeCarrito) {
                let nuevaCant = parseInt(badgeCarrito.innerText) - cantidadRestar;
                badgeCarrito.innerText = nuevaCant < 0 ? 0 : nuevaCant;
            }

            // Restar del Subtotal General
            const spanSubtotalNav = document.getElementById('subtotalCarritoNav');
            if(spanSubtotalNav) {
                let dineroActual = parseFloat(spanSubtotalNav.innerText) || 0.00;
                let nuevoSubtotal = dineroActual - dineroRestar;
                spanSubtotalNav.innerText = nuevoSubtotal <= 0 ? "0.00" : nuevoSubtotal.toFixed(2);
            }

            // Eliminar la fila del HTML
            fila.remove();

            // Si ya no quedan libros, volvemos a mostrar el mensaje de "Carrito Vacío"
            const listaItems = document.getElementById('listaItemsCarrito');
            const itemsRestantes = listaItems.querySelectorAll('.item-carrito-fila').length;
            if (itemsRestantes === 0) {
                const mensajeVacio = document.getElementById('mensajeCarritoVacio');
                if(mensajeVacio) mensajeVacio.style.display = 'block';
            }
        }

        // NUEVA FUNCIÓN: Para que los botones + y - del carrito funcionen
        function cambiarCantidadCarrito(btn, delta, precioUnitario) {
            const inputElement = btn.parentElement.querySelector('.item-cantidad');
            let cantidadActual = parseInt(inputElement.value);
            
            // Evitar que baje a cero (para eliminar está el botón "Eliminar")
            if (cantidadActual + delta < 1) return;
            
            inputElement.value = cantidadActual + delta;

            // Actualizar burbuja
            const badgeCarrito = document.querySelector('.fa-shopping-basket').nextElementSibling;
            if(badgeCarrito) {
                badgeCarrito.innerText = parseInt(badgeCarrito.innerText) + delta;
            }

            // Actualizar Subtotal General
            const spanSubtotalNav = document.getElementById('subtotalCarritoNav');
            if(spanSubtotalNav) {
                let dineroActual = parseFloat(spanSubtotalNav.innerText) || 0.00;
                let nuevoSubtotal = dineroActual + (precioUnitario * delta);
                spanSubtotalNav.innerText = nuevoSubtotal.toFixed(2);
                
                spanSubtotalNav.style.color = "#ffa41c";
                setTimeout(() => spanSubtotalNav.style.color = "", 500);
            }
        }

        // 4. RESEÑAS INTERACTIVAS
        function marcarEstrellas(cantidad) {
            document.getElementById('inputPuntuacion').value = cantidad;
            const estrellas = document.getElementById('selectorEstrellas').children;
            for(let i = 0; i < 5; i++) {
                if(i < cantidad) {
                    estrellas[i].classList.remove('far'); 
                    estrellas[i].classList.add('fas', 'active'); 
                } else {
                    estrellas[i].classList.remove('fas', 'active');
                    estrellas[i].classList.add('far');
                }
            }
        }

        function publicarOpinion() {
            const titulo = document.getElementById('inputTituloResena').value || "Sin título";
            const texto = document.getElementById('inputTextResena').value || "El usuario no dejó un comentario escrito.";
            const puntos = parseInt(document.getElementById('inputPuntuacion').value);
            
            let estrellasHTML = '';
            for(let i=0; i<5; i++) {
                estrellasHTML += (i < puntos) ? '<i class="fas fa-star"></i>' : '<i class="far fa-star"></i>';
            }

            const nuevaResena = `
            <div class="mb-4 opinion-item" style="animation: fadeIn 1s;">
                <div class="d-flex align-items-center mb-1">
                    <i class="fas fa-user-circle fa-2x text-info mr-2"></i>
                    <span class="text-dark font-weight-bold small ml-2">Tú (Usuario UTEC)</span>
                </div>
                <div class="d-flex align-items-center mb-1">
                    <span class="text-warning small mr-2">${estrellasHTML}</span>
                    <strong class="text-dark" style="font-size: 0.95rem;">${titulo}</strong>
                </div>
                <p class="text-muted small mb-2">Calificado justo ahora <br><span class="text-danger">Compra Verificada</span></p>
                <p class="text-dark" style="font-size: 0.95rem;">${texto}</p>
            </div>`;

            document.getElementById('listaOpiniones').insertAdjacentHTML('afterbegin', nuevaResena);
            $('#modalOpinion').modal('hide');
            document.getElementById('inputTituloResena').value = '';
            document.getElementById('inputTextResena').value = '';
            alert("¡Tu opinión se ha publicado exitosamente en la página!");
        }
    </script>
}